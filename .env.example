# ==============================================================================
# MDM Parental Control - Environment Configuration Template
# Copy this file to .env and fill in your actual credentials.
# NEVER commit .env to version control!
# ==============================================================================

# Telegram Notification (HUB-LOG & HniBOT)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHANNEL_ID=your_telegram_channel_id_here

# macOS Remote Build Machine (for iOS Enterprise compilation)
MAC_BUILD_HOST=100.111.x.x
MAC_BUILD_USER=mac_user
MAC_KEYCHAIN_PASSWORD=mac_keychain_password

# iOS Enterprise Code Signing
IOS_P12_PASSWORD=p12_certificate_password
IOS_TEAM_ID=YOUR_TEAM_ID
IOS_PROFILE_UUID=your_profile_uuid

# Supabase Backend
SUPABASE_URL=https://<your-project-ref>.supabase.co
SUPABASE_ANON_KEY=<your-anon-key>
